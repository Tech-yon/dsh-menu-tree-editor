{
  "name": "@local/dsh-menu-tree-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DSH大记记 — a notes workspace for the DSH Web UI: a notebook with groups, history and local-file linking, plus the multi-level menu tree editor under the Advanced menu.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tech-yon/DSH-Dajiji.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
